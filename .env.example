# App
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://youhooalert.com
ADMIN_EMAILS=admin@youhooalert.com

# PostgreSQL (pooled = API runtime, unpooled = Alembic)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# Redis (notification queue)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (mobile id_token verification)
GOOGLE_OAUTH_CLIENT_ID=

# Firebase — see firebase/README.md
# google-services.json = Android app only (in firebase/google-services.json)
# API push needs service account JSON from Firebase Console → Service accounts
FIREBASE_PROJECT_ID=youhoo-alert-app
FIREBASE_ANDROID_PACKAGE=com.youhooalert.app
FIREBASE_IOS_BUNDLE_ID=com.youhoolert.app
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}  # Vercel alternative

# Stripe donations (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate limiting
ALERT_RATE_LIMIT=5/minute
