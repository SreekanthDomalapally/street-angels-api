# Comma-separated origins allowed for CORS (include your Next.js dev URL)
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE=sa_session
SESSION_MAX_AGE=604800

# --- Vercel Postgres / Neon (Storage tab → .env.local) ---
# Use the pooled URL for the running API (either name works).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require
# POSTGRES_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require

# Unpooled URL (migrations / one-off admin only — not for uvicorn)
# DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require
