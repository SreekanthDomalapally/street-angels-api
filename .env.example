# Comma-separated origins allowed for CORS (include your Next.js dev URL)
CORS_ORIGINS=http://localhost:3000,https://youhooalert.com
ADMIN_EMAILS=admin@youhooalert.com
SESSION_COOKIE=sa_session
SESSION_MAX_AGE=604800

# Paste from Vercel Storage → .env.local (Neon). API accepts either naming style:

# Pooled — API runtime
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL=...

# Direct — Alembic only (no -pooler in hostname)
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL_NON_POOLING=...
