# App
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://youhooalert.com
ADMIN_EMAILS=admin@youhooalert.com

# --- Railway PostgreSQL ---
#
# LOCAL .env — paste the REAL URL from Postgres service → Variables → DATABASE_PUBLIC_URL
# (Click reveal/copy — NOT the ${{...}} template)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://postgres:PASSWORD@HOST:PORT/railway?sslmode=require
#
# RAILWAY API SERVICE (Variables tab) — reference linked Postgres:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}
# Railway resolves this automatically when Postgres is linked to your API service.

# Redis (notification queue)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=

# Firebase — see firebase/README.md
FIREBASE_PROJECT_ID=youhoo-alert-app
FIREBASE_ANDROID_PACKAGE=com.youhooalert.app
FIREBASE_IOS_BUNDLE_ID=com.youhoolert.app
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ALERT_RATE_LIMIT=5/minute
