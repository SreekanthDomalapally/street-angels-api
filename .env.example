# Comma-separated origins allowed for CORS (include your Next.js dev URL)
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE=sa_session
SESSION_MAX_AGE=604800

# --- Vercel Postgres (Storage tab → .env.local) ---
# Copy POSTGRES_URL from Vercel and paste below (either name works).
POSTGRES_URL=postgresql://user:password@host/db?sslmode=require
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
